---
import downloads from '../data/downloads.json';
import { isPlaceholder } from '../data/media';
const {id} = Astro.props;
const item = downloads[id as 'resume'];
const placeholder = isPlaceholder(item.path);
---
{!placeholder && <div class="download">
  <a href={item.path} download>{item.label} <span class="format">PDF</span></a>
  <p>{item.audience}</p>
  {downloads.issueDate && <p>Issued <time datetime={downloads.issueDate}>{downloads.issueDate}</time></p>}
</div>}
