---
import '../styles/global.css';
import assets from '../data/assets.json';
import Figure from '../components/Figure.astro';
import LocalVideo from '../components/LocalVideo.astro';
import Download from '../components/Download.astro';
import {render} from '../data/render';
import Home from '../components/Home.astro';
const {page} = Astro.props;
const home=!page.slug;
const headings = page.blocks.filter((b:any)=>b.type==='heading');
const canonical = new URL(page.route, Astro.site);
---
<!doctype html>
<html lang="en-US" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={page.title} />
    <title>{page.title}{page.slug ? ' | Patrick Thangarajah' : ''}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" href="/fonts/source-serif-4-latin-400-normal.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/source-sans-3-latin-400-normal.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/source-sans-3-latin-600-normal.woff2" type="font/woff2" crossorigin />
    <script is:inline>
      try { const preference = localStorage.getItem('theme'); if(preference === 'light' || preference === 'dark') document.documentElement.dataset.theme = preference; } catch {}
    </script>
  </head>
  <body class:list={{homepage:home}}>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a class="identity" href="/">Patrick Thangarajah<span class="role-line">Mechanical Engineering Graduate</span></a>
      <nav aria-label="Primary"><a href="/#selected-work">Work</a><a href="/#engineering-approach">Approach</a><a href="/#experience">Experience</a><a href="/#contact">Contact</a><a href="/#resume">Resume</a></nav>
      <button class="theme-toggle" type="button" aria-label="Use dark mode" aria-pressed="false">Dark mode</button>
    </header>
    <div class:list={["document-grid", {"home-grid":home}]}>
      {!home && headings.length>3 && <aside class="contents">
        <details open>
          <summary>On this page</summary>
          <nav aria-label="On this page"><ol>{headings.map((h:any)=><li><a href={`#${h.id}`}>{h.title}</a></li>)}</ol></nav>
        </details>
      </aside>}
      <main id="main" tabindex="-1">
        {page.slug && <a class="back-link" href="/#selected-work">All projects</a>}
        {home ? <Home/> : <article class="project-document">
          <p class="eyebrow">Engineering project / Technical record</p>
          <h1>{page.title}</h1>
          {page.blocks.map((block:any) => {
            if(block.type==='heading') return <h2 id={block.id}>{block.title}<a class="heading-anchor" href={`#${block.id}`} aria-label={`Link to ${block.title}`}>§</a><span class="fringe-rule" aria-hidden="true"></span></h2>;
            if(block.type==='markdown') return <div class="prose-block" set:html={render(block.text,page.title)} />;
            if(block.type==='download') return <Download id={block.id} />;
            const a = (assets as any)[block.id];
            return a.type==='video' ? <LocalVideo webm={a.path} mp4={a.mp4} poster={a.poster} caption={a.caption} description={a.description} alt={a.alt} number={block.number} width={a.width} height={a.height} /> : <Figure asset={a} number={block.number} />;
          })}
        </article>}
      </main>
    </div>
    <footer><a href="mailto:ptemmanual@gmail.com">Email</a><a href="https://www.linkedin.com/in/patrickthangarajah/">LinkedIn</a><a href="https://github.com/PatrickThangarajah">GitHub</a><a href="#main">Back to top</a></footer>
    <script>
      const root = document.documentElement;
      const header=document.querySelector<HTMLElement>('.site-header');
      if(header){const measureHeader=()=>root.style.setProperty('--header-offset',`${header.offsetHeight+24}px`);measureHeader();new ResizeObserver(measureHeader).observe(header);}
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const system = matchMedia('(prefers-color-scheme: dark)');
      const dark = () => root.dataset.theme ? root.dataset.theme==='dark' : system.matches;
      const update = () => { button.textContent = dark() ? 'Light mode' : 'Dark mode'; button.setAttribute('aria-label',dark()?'Use light mode':'Use dark mode'); button.setAttribute('aria-pressed',String(dark())); };
      update(); system.addEventListener('change',update);
      button.addEventListener('click',()=>{root.dataset.theme=dark()?'light':'dark';try{localStorage.setItem('theme',root.dataset.theme);}catch{}update();});
      const detail=document.querySelector<HTMLDetailsElement>('.contents details')!;
      const narrow=matchMedia('(max-width: 1100px)');
      const adapt=()=>{if(detail)detail.open=!narrow.matches;};adapt();narrow.addEventListener('change',adapt);
      const links=[...document.querySelectorAll<HTMLAnchorElement>('.contents a, .homepage .site-header nav a')];
      const observed=[...document.querySelectorAll<HTMLHeadingElement>('article h2[id], .homepage .home-section[id]')];
      const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){links.forEach(a=>{if(a.hash==='#'+entry.target.id)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}}},{rootMargin:'-5% 0px -50% 0px'});
      observed.forEach(h=>observer.observe(h));
      const reduced=matchMedia('(prefers-reduced-motion: reduce)');
      const entrance={duration:400,easing:'cubic-bezier(0.16, 1, 0.3, 1)'};
      if(!reduced.matches)document.querySelectorAll('.hero-enter').forEach((el,i)=>el.animate([{opacity:0,transform:'translateY(16px)'},{opacity:1,transform:'translateY(0)'}],{...entrance,delay:i*80,fill:'backwards'}));
      const reveals=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){
        if(!reduced.matches){
          const el=entry.target as HTMLElement;
          el.animate([{opacity:0,transform:'translateY(20px)'},{opacity:1,transform:'translateY(0)'}],{...entrance,delay:parseInt(el.style.getPropertyValue('--stagger'))||0,fill:'backwards'});
          el.querySelectorAll('.fringe-rule,.step-edge').forEach((rule,i)=>rule.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:600,easing:entrance.easing,delay:i*60,fill:'backwards'}));
        }
        reveals.unobserve(entry.target);
      }});},{threshold:.12});
      document.querySelectorAll('.project-card,.section-heading,.walkthrough,.approach-card,.project-document>h2').forEach(el=>reveals.observe(el));
      const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const cards=[...document.querySelectorAll<HTMLElement>('[data-disciplines]')];
      filters.forEach(filter=>filter.addEventListener('click',()=>{
        filters.forEach(button=>button.setAttribute('aria-pressed',String(button===filter)));
        let count=0;
        cards.forEach(card=>{card.hidden=filter.dataset.filter!=='All'&&!card.dataset.disciplines?.split('|').includes(filter.dataset.filter!);if(!card.hidden)count++;});
        const status=document.getElementById('filter-status');if(status)status.textContent=`${count} projects shown. ${filter.dataset.filter}.`;
      }));
      reduced.addEventListener('change',()=>{if(reduced.matches)document.getAnimations().forEach(a=>a.cancel());});
      // Anchor destinations inside disclosures remain reachable.
      const openHash=()=>{if(!location.hash)return;const target=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(!target)return;let parent=target.parentElement;while(parent){if(parent instanceof HTMLDetailsElement)parent.open=true;parent=parent.parentElement;}};
      addEventListener('hashchange',openHash);openHash();
      let printOpen:HTMLDetailsElement[]=[];
      addEventListener('beforeprint',()=>{printOpen=[...document.querySelectorAll<HTMLDetailsElement>('details:not([open])')];printOpen.forEach(d=>d.open=true);});
      addEventListener('afterprint',()=>printOpen.forEach(d=>d.open=false));
    </script>
  </body>
</html>
