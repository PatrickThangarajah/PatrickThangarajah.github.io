---
import '../styles/global.css';
import assets from '../data/assets.json';
import Figure from '../components/Figure.astro';
import LocalVideo from '../components/LocalVideo.astro';
import AnchorComparison from '../components/AnchorComparison.astro';
import Download from '../components/Download.astro';
import {render} from '../data/render';
import Home from '../components/Home.astro';
import ThorProject from '../components/ThorProject.astro';
const {page} = Astro.props;
const home=!page.slug;
const headings = page.slug==='thor-5f' ? [
  {id:'research-workflow',title:'Research Workflow'},
  {id:'key-results',title:'Key Results'},
  {id:'anchor-response',title:'Anchor Response'},
  {id:'engineering-interpretation',title:'Engineering Interpretation'}
] : page.blocks.filter((b:any)=>b.type==='heading');
const canonical = new URL(page.route, Astro.site);
const firstMarkdown=page.blocks.find((b:any)=>b.type==='markdown')?.text ?? page.title;
const plain=(text:string)=>text
  .replace(/<br\s*\/?\s*>/gi,' ')
  .replace(/\[([^\]]+)\]\([^\)]+\)/g,'$1')
  .replace(/[*_`#>|]/g,'')
  .replace(/\s+/g,' ')
  .trim();
const description=plain(firstMarkdown).slice(0,180);
const firstAssetBlock=page.blocks.find((b:any)=>b.type==='asset');
const socialAsset:any=home ? (assets as any).A01 : firstAssetBlock ? (assets as any)[firstAssetBlock.id] : (assets as any).A01;
const socialImage=socialAsset?.path ? new URL(socialAsset.path,Astro.site) : undefined;
const groupProjectSlugs=['bladder-test-platform','payload-and-rover','kidney-tissue-classification'];
const contributionIndex=groupProjectSlugs.includes(page.slug) ? page.blocks.findIndex((b:any)=>b.type==='heading'&&(b.title==='My Individual Contribution'||b.title==='My Contribution')) : -1;
const contributionHeading=contributionIndex>=0 ? page.blocks[contributionIndex] : null;
const contributionBlock=contributionIndex>=0 ? page.blocks[contributionIndex+1] : null;
---
<!doctype html>
<html lang="en-US" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialAsset?.alt && <meta property="og:image:alt" content={socialAsset.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{page.title}{page.slug ? ' | Patrick Thangarajah' : ''}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" href="/fonts/source-serif-4-latin-400-normal.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/source-sans-3-latin-400-normal.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/source-sans-3-latin-600-normal.woff2" type="font/woff2" crossorigin />
    <script is:inline>
      try { const preference = localStorage.getItem('theme'); if(preference === 'light' || preference === 'dark') document.documentElement.dataset.theme = preference; } catch {}
    </script>
  </head>
  <body class:list={{homepage:home,"thor-page":page.slug==='thor-5f'}}>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a class="identity" href="/">Patrick Thangarajah<span class="role-line">Mechanical Engineering Graduate</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu</button>
      <nav id="primary-nav" aria-label="Primary"><a href="/#selected-work">Work</a><a href="/#experience">Experience</a><a href="/#contact">Contact</a><a href="/#resume">Resume</a></nav>
      <button class="theme-toggle" type="button" aria-label="Use dark mode" aria-pressed="false">Dark mode</button>
    </header>
    <div class:list={["document-grid", {"home-grid":home}]}>
      {!home && headings.length>3 && <aside class="contents">
        <details>
          <summary>On this page</summary>
          <nav aria-label="On this page"><ol>{headings.filter((h:any)=>h.id!==contributionHeading?.id).map((h:any)=><li><a href={`#${h.id}`}>{h.title}</a></li>)}</ol></nav>
        </details>
      </aside>}
      <main id="main" tabindex="-1">
        {page.slug && <a class="back-link" href="/#selected-work">All projects</a>}
        {home ? <Home/> : page.slug==='thor-5f' ? <ThorProject page={page} /> : <article class="project-document">
          <h1>{page.title}</h1>
          {contributionHeading && contributionBlock?.type==='markdown' && <aside class="boundary-callout contribution-summary"><h3>{contributionHeading.title}</h3><div set:html={render(contributionBlock.text,page.title)} /></aside>}
          {page.blocks.map((block:any,i:number) => {
            if(i===contributionIndex||i===contributionIndex+1) return null;
            if(block.type==='heading') return <h2 id={block.id}>{block.title}<a class="heading-anchor" href={`#${block.id}`} aria-label={`Link to ${block.title}`}>§</a><span class="fringe-rule" aria-hidden="true"></span></h2>;
            if(block.type==='markdown') return <div class="prose-block" set:html={render(block.text,page.title)} />;
            if(block.type==='download') return <Download id={block.id} />;
            const a = (assets as any)[block.id];
            const media = a.type==='video' ? <LocalVideo webm={a.path} mp4={a.mp4} poster={a.poster} caption={a.caption} description={a.description} alt={a.alt} number={block.number} width={a.width} height={a.height} /> : <Figure asset={a} number={block.number} />;
            return <>{media}{page.slug==='seat-belt-doe' && block.id==='G03' && <AnchorComparison />}</>;
          })}
        </article>}
      </main>
    </div>
    <footer><a href="mailto:ptemmanual@gmail.com">Email</a><a href="https://www.linkedin.com/in/patrickthangarajah/">LinkedIn</a><a href="https://github.com/PatrickThangarajah">GitHub</a><a href="#main">Back to top</a></footer>
    <script>
      const root = document.documentElement;
      const header=document.querySelector<HTMLElement>('.site-header');
      if(header){const measureHeader=()=>root.style.setProperty('--header-offset',`${header.offsetHeight+24}px`);measureHeader();new ResizeObserver(measureHeader).observe(header);}
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const system = matchMedia('(prefers-color-scheme: dark)');
      const dark = () => root.dataset.theme ? root.dataset.theme==='dark' : system.matches;
      const update = () => { button.textContent = dark() ? 'Light mode' : 'Dark mode'; button.setAttribute('aria-label',dark()?'Use light mode':'Use dark mode'); button.setAttribute('aria-pressed',String(dark())); };
      update(); system.addEventListener('change',update);
      button.addEventListener('click',()=>{root.dataset.theme=dark()?'light':'dark';try{localStorage.setItem('theme',root.dataset.theme);}catch{}update();});
      const menuToggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
      const primaryNav=document.getElementById('primary-nav');
      if(menuToggle&&primaryNav){
        const closeMenu=()=>{menuToggle.setAttribute('aria-expanded','false');primaryNav.classList.remove('nav-open');menuToggle.textContent='Menu';};
        const openMenu=()=>{menuToggle.setAttribute('aria-expanded','true');primaryNav.classList.add('nav-open');menuToggle.textContent='Close';};
        menuToggle.addEventListener('click',()=>{menuToggle.getAttribute('aria-expanded')==='true'?closeMenu():openMenu();});
        primaryNav.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
        document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menuToggle.getAttribute('aria-expanded')==='true'){closeMenu();menuToggle.focus();}});
        matchMedia('(max-width: 1100px)').addEventListener('change',e=>{if(!e.matches)closeMenu();});
      }
      const detail=document.querySelector<HTMLDetailsElement>('.contents details')!;
      const narrow=matchMedia('(max-width: 1100px)');
      const adapt=()=>{if(detail)detail.open=!narrow.matches;};adapt();narrow.addEventListener('change',adapt);
      const links=[...document.querySelectorAll<HTMLAnchorElement>('.contents a, .homepage .site-header nav a')];
      const observed=[...document.querySelectorAll<HTMLHeadingElement>('article h2[id], .homepage .home-section[id]')];
      const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){links.forEach(a=>{if(a.hash==='#'+entry.target.id)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}}},{rootMargin:'-5% 0px -50% 0px'});
      observed.forEach(h=>observer.observe(h));
      const reduced=matchMedia('(prefers-reduced-motion: reduce)');
      const entrance={duration:400,easing:'cubic-bezier(0.16, 1, 0.3, 1)'};
      if(!reduced.matches)document.querySelectorAll('.hero-enter').forEach((el,i)=>el.animate([{opacity:0,transform:'translateY(16px)'},{opacity:1,transform:'translateY(0)'}],{...entrance,delay:i*80,fill:'backwards'}));
      const reveals=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){
        if(!reduced.matches){
          const el=entry.target as HTMLElement;
          el.animate([{opacity:0,transform:'translateY(20px)'},{opacity:1,transform:'translateY(0)'}],{...entrance,delay:parseInt(el.style.getPropertyValue('--stagger'))||0,fill:'backwards'});
          el.querySelectorAll('.fringe-rule,.step-edge').forEach((rule,i)=>rule.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:600,easing:entrance.easing,delay:i*60,fill:'backwards'}));
        }
        reveals.unobserve(entry.target);
      }});},{threshold:.12});
      document.querySelectorAll('.gallery-item,.section-heading,.project-document>h2').forEach(el=>reveals.observe(el));
      reduced.addEventListener('change',()=>{if(reduced.matches)document.getAnimations().forEach(a=>a.cancel());});
      const openHash=()=>{if(!location.hash)return;const target=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(!target)return;let parent=target.parentElement;while(parent){if(parent instanceof HTMLDetailsElement)parent.open=true;parent=parent.parentElement;}};
      addEventListener('hashchange',openHash);openHash();
      let printOpen:HTMLDetailsElement[]=[];
      addEventListener('beforeprint',()=>{printOpen=[...document.querySelectorAll<HTMLDetailsElement>('details:not([open])')];printOpen.forEach(d=>d.open=true);});
      addEventListener('afterprint',()=>printOpen.forEach(d=>d.open=false));
    </script>
  </body>
</html>
