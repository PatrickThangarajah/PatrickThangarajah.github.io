---
import { isPlaceholder } from '../data/media';
interface Props { webm: string; mp4: string; poster: string; caption: string; description: string; alt: string; number: number; width: number; height: number; }
const {webm, mp4, poster, caption, description, alt, number, width, height} = Astro.props;
if (!poster || !webm || !mp4 || !description) throw new Error('LocalVideo requires both sources, a poster, and a description.');
const id = `video-${number}`;
const placeholder = isPlaceholder(webm);
---
{!placeholder && <figure class="local-video" aria-labelledby={`${id}-caption`}>
  <video id={id} width={width} height={height} poster={poster} muted loop playsinline preload="metadata" controls aria-label={caption} aria-describedby={`${id}-description`}>
    <source src={webm} type="video/webm" />
    <source src={mp4} type="video/mp4" />
    <p>{description} <a href={mp4}>Download the MP4 video</a>.</p>
  </video>
  <img class="print-poster" src={poster} width={width} height={height} alt={alt} />
  <figcaption id={`${id}-caption`}><span class="figure-number">Figure {number}.</span> {caption}</figcaption>
  <p class="figure-description" id={`${id}-description`}>{description}</p>
</figure>}
<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLVideoElement>('.local-video video').forEach(video => {
    video.muted = true;
    let inView=false;
    let hovering=false;
    let userPaused=false;
    let automaticPause=false;
    const pause=()=>{automaticPause=true;video.pause();};
    const sync=()=>{if(!inView||document.hidden||motion.matches||!hovering){pause();return;}if(pointer.matches&&!userPaused){automaticPause=false;video.play().catch(()=>{});}};
    video.addEventListener('pointerenter',()=>{hovering=true;userPaused=false;sync();});
    video.addEventListener('pointerleave',()=>{hovering=false;if(pointer.matches)pause();});
    video.addEventListener('pause',()=>{if(!automaticPause)userPaused=true;});
    video.addEventListener('play',()=>{automaticPause=false;userPaused=false;});
    const observer=new IntersectionObserver(entries=>{inView=entries[0].isIntersecting;if(!inView)pause();},{threshold:.25});
    observer.observe(video);
    motion.addEventListener('change',()=>{if(motion.matches)pause();});
    document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});
  });
</script>
