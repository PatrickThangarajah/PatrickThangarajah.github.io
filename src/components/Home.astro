---
import pages from '../data/pages.json';
import assets from '../data/assets.json';
import {isPlaceholder} from '../data/media';
import {render} from '../data/render';
import Download from './Download.astro';
const hub=pages[0];
const section=(id:string)=>{const start=hub.blocks.findIndex((b:any)=>b.id===id);let end=hub.blocks.findIndex((b:any,i:number)=>i>start&&b.type==='heading');if(end<0)end=hub.blocks.length;return hub.blocks.slice(start+1,end).filter((b:any)=>b.type==='markdown').map((b:any)=>b.text).join('\n\n');};
const cards=[
 {slug:'cervical-fracture',asset:'A14',title:'Cervical fracture mechanics',tags:'Explicit dynamics / Injury biomechanics',copy:'Comparing Hybrid III injury criteria with GHBMC fracture predictions in head-first football impacts.',metrics:[['5','impact configurations']],categories:['CAE / FEA','Biomechanics']},
 {slug:'seat-foam',asset:'A25',title:'Seat foam and rear impact',tags:'FEA / Material response',copy:'Trace the response from foam material checks to rear impact injury measures.',metrics:[['27 and 57 km/h','simulation speeds']],categories:['CAE / FEA']},
 {slug:'payload-and-rover',asset:'A31',title:'Payload systems and rover prototypes',tags:'CAD / Prototyping',copy:'Wheel, rover, and winch designs developed for a lightweight aerial payload system.',metrics:[],categories:['Design / Test']},
 {slug:'kidney-tissue-classification',asset:'A28',title:'Kidney tissue classification',tags:'Biomedical research / Deep learning',copy:'My work on image preparation, model training, and evaluation in an AlexNet classification workflow.',metrics:[],categories:['Biomechanics']}
];
const bladder={slug:'bladder-test-platform',asset:'A18',title:'A distensible bladder test platform',tags:'Design / Controls / Physical testing',copy:'From silicone phantom to pressure measurement: my sensing, control, and data acquisition work within a four-person capstone.',metrics:[['24.3%','team pressure-volume curve error']]};
const toolkit=section('technical-toolkit');
const rows=[...toolkit.matchAll(/<tr>([\s\S]*?)<\/tr>/g)].slice(1).map(r=>[...r[1].matchAll(/<td>([\s\S]*?)<\/td>/g)].map(c=>c[1].trim()));
const history=(id:string)=>[...section(id).matchAll(/<tr>([\s\S]*?)<\/tr>/g)].slice(1).map(r=>[...r[1].matchAll(/<td>([\s\S]*?)<\/td>/g)].map(c=>c[1].trim()));
const contribution=pages.find(p=>p.slug==='thor-5f')!.blocks.find((b:any)=>b.text?.includes('The physical Rigid Bench tests')) as any;
const boundary=contribution.text.slice(contribution.text.indexOf('The physical Rigid Bench tests'));
const steps=contribution.text.split('\n').filter((s:string)=>s.startsWith('- ')).slice(0,4).map((s:string)=>s.slice(2));
const hero=assets.A01;
const bladderAsset=(assets as any)[bladder.asset];
const intro=(hub.blocks[0] as any).text.split('\n')[1];
---
<section class="home-hero" aria-labelledby="intro-title">
  <div class="hero-copy"><p class="print-identity">Patrick Thangarajah</p>
    <p class="eyebrow hero-enter">Calgary, Alberta, Canada</p>
    <h1 id="intro-title" class="hero-enter">Mechanical Engineering Graduate</h1>
    <div class="hero-enter"><ul class="focus-areas"><li>Occupant Safety</li><li>Explicit Dynamics</li><li>FEA / Model Validation</li><li>Engineering Design</li></ul><p class="hero-support">{intro}</p></div>
    <div class="hero-actions hero-enter"><a class="button-link" href="#selected-work">My work <span aria-hidden="true">↓</span></a><a class="button-link secondary-button" href="#resume">Resume & portfolio</a></div>
    <p class="eligibility hero-enter">Canadian citizen eligible to work in the United States under TN status</p>
  </div>
</section>
<section id="selected-work" class="home-section" aria-labelledby="work-title">
  <div class="section-heading"><p class="eyebrow">01 / Work</p><h2 id="work-title">Selected work</h2><span class="fringe-rule" aria-hidden="true"></span></div>
  <article class="featured-study">
    <div class="featured-intro"><div><p class="eyebrow">Graduate Research</p><h3><a href="/projects/thor-5f/">THOR-5F Rear Seat Occupant Safety Research</a></h3><p>How does seat belt anchor position change occupant response? Explore the validated THOR-5F bench models and anchor studies.</p><p>Peak chest deflection in the identified configurations</p><dl class="card-metrics"><div><dt>below the Rigid Bench study average</dt><dd>17%</dd></div><div><dt>below the Semi-Rigid Bench study average</dt><dd>16%</dd></div></dl><p>Each bench achieved an average ISO 18571 rating of 0.71 across ten signals, corresponding to a Fair grade.</p></div><figure class="hero-figure"><a class:list={["hero-media",{"placeholder-media":isPlaceholder(hero.path)}]} href="/projects/thor-5f/" style={`aspect-ratio:${hero.width}/${hero.height}`}><img src={hero.path} alt={isPlaceholder(hero.path)?'Placeholder for: '+hero.alt:hero.alt} width={hero.width} height={hero.height} loading="lazy" /></a><figcaption>THOR-5F rear seat occupant safety research</figcaption>{isPlaceholder(hero.path)&&<p class="asset-status">Engineering figure pending</p>}</figure></div>
    <ol class="walkthrough">{steps.map((text:string,i:number)=><li class="step-card"><span class="step-edge" aria-hidden="true"></span><span class="step-number">0{i+1}</span><p>{text}</p></li>)}</ol>
    <div class="technical-links"><p class="eyebrow">Inside the research</p><a href="/projects/fe-validation/">Model validation</a><a href="/projects/seat-belt-doe/">Anchor DOE & statistical analysis</a><a href="/projects/ls-prepost-automation/">LS-PrePost automation</a><a href="/projects/design-and-applied-research/">Design & applied research index</a></div>
    <aside class="boundary-callout"><h3>Contribution & public sharing</h3><p>{boundary}</p><div set:html={render(section('publications-presentations').split('**Public-sharing note:**')[1],hub.title)}/></aside>
  </article>

  <article class="featured-study secondary-feature">
    <div class="featured-intro"><div><p class="eyebrow">{bladder.tags}</p><h3><a href={`/projects/${bladder.slug}/`}>{bladder.title}</a></h3><p>{bladder.copy}</p><dl class="card-metrics">{bladder.metrics.map(([value,label])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div><figure class="hero-figure"><a class:list={["hero-media",{"placeholder-media":isPlaceholder(bladderAsset.path)}]} href={`/projects/${bladder.slug}/`} style={`aspect-ratio:${bladderAsset.width}/${bladderAsset.height}`}><img src={bladderAsset.path} alt={isPlaceholder(bladderAsset.path)?'Placeholder for: '+bladderAsset.alt:bladderAsset.alt} width={bladderAsset.width} height={bladderAsset.height} loading="lazy" decoding="async" /></a><figcaption>{bladderAsset.caption}</figcaption>{isPlaceholder(bladderAsset.path)&&<p class="asset-status">Engineering figure pending</p>}</figure></div>
  </article>

  <div class="project-filters" role="group" aria-label="Filter projects">{['All','CAE / FEA','Design / Test','Biomechanics'].map((label,i)=><button type="button" data-filter={label} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div>
  <p class="sr-only" role="status" id="filter-status" aria-live="polite"></p>
  <div class="project-grid">{cards.map((c,i)=>{const a=(assets as any)[c.asset];return <article class="project-card" data-disciplines={c.categories.join('|')} style={`--stagger:${i%2*60}ms`}>
    <a class:list={["card-image",{"placeholder-media":isPlaceholder(a.path)}]} style={`aspect-ratio:${a.width}/${a.height}`} href={`/projects/${c.slug}/`} aria-label={`${isPlaceholder(a.path)?'Figure pending. ':''}Explore ${c.title}`}><img src={a.path} alt={isPlaceholder(a.path)?'Placeholder for: '+a.alt:a.alt} width={a.width} height={a.height} loading="lazy" decoding="async" />{isPlaceholder(a.path)&&<span class="media-label">Figure pending</span>}</a>
    <div class="card-copy"><p class="eyebrow">{c.tags}</p><h3><a href={`/projects/${c.slug}/`}>{c.title}</a></h3><p>{c.copy}</p>{c.metrics.length>0&&<dl class="card-metrics">{c.metrics.map(([value,label])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}</div>
  </article>;})}</div>
</section>
<section id="technical-toolkit" class="home-section" aria-labelledby="toolkit-title"><div class="section-heading"><h2 id="toolkit-title">Technical toolkit</h2><span class="fringe-rule" aria-hidden="true"></span></div><div class="toolkit-tags">{rows.map(([label,tools])=><div><h3>{label}</h3><p>{tools}</p></div>)}</div></section>
<section id="experience" class="home-section background-section" aria-labelledby="background-title"><div class="section-heading"><p class="eyebrow">02 / Experience</p><h2 id="background-title">Experience & education</h2><span class="fringe-rule" aria-hidden="true"></span></div>
  <div id="education"><h3>Education</h3><div class="timeline">{history('education').map(([period,degree,org])=><div><p class="timeline-date">{period}</p><div><h3>{org}</h3><p>{degree}</p></div></div>)}</div></div>
  <h3>Engineering experience</h3><div class="timeline">{history('experience').map(([period,role,org])=><div><p class="timeline-date">{period}</p><div><h3>{role.split('<br>')[0].replaceAll('**','')}</h3><p class="organization">{org}</p><div set:html={render(role.split('<br>').slice(1).join('<br>'),'Experience')}/></div></div>)}</div>
  <details id="about-me" class="disclosure"><summary>About my work</summary><p>Simulation, measurement, and engineering design.</p><div class="reading-column" set:html={render((hub.blocks[0] as any).text,hub.title)}/><div class="reading-column" set:html={render(section('about-me'),hub.title)}/><div id="at-a-glance" class="reading-column" set:html={render(section('at-a-glance'),hub.title)}/></details>
  <details id="publications-presentations" class="disclosure"><summary>Publications & presentations</summary><div class="reading-column" set:html={render(section('publications-presentations'),hub.title)}/></details>
  <details id="public-code-and-workflow-artifacts" class="disclosure"><summary>Public code & workflow artifacts</summary><div class="reading-column" set:html={render(section('public-code-and-workflow-artifacts'),hub.title)}/></details>
</section>
<section id="contact" class="home-section" aria-labelledby="contact-title"><div class="section-heading"><p class="eyebrow">03 / Contact</p><h2 id="contact-title">Patrick Thangarajah</h2><span class="fringe-rule" aria-hidden="true"></span></div><div class="contact-links"><a href="mailto:ptemmanual@gmail.com">ptemmanual@gmail.com</a><a href="https://www.linkedin.com/in/patrickthangarajah/">LinkedIn</a><a href="https://github.com/PatrickThangarajah">GitHub</a></div>
<div id="resume"><h3>Resume & portfolio</h3><div class="download-grid"><Download id="resume"/><div id="downloadable-portfolio"><Download id="portfolio"/></div></div><details class="disclosure"><summary>Document details & work eligibility</summary><div class="reading-column" set:html={render(section('resume')+'\n\n'+section('downloadable-portfolio'),hub.title)}/></details></div></section>
