---
import pages from '../data/pages.json';
import assets from '../data/assets.json';
import {isPlaceholder} from '../data/media';
import {render} from '../data/render';
import Download from './Download.astro';
import '../styles/refined.css';
const hub=pages[0];
const section=(id:string)=>{const start=hub.blocks.findIndex((b:any)=>b.id===id);let end=hub.blocks.findIndex((b:any,i:number)=>i>start&&b.type==='heading');if(end<0)end=hub.blocks.length;return hub.blocks.slice(start+1,end).filter((b:any)=>b.type==='markdown').map((b:any)=>b.text).join('\n\n');};
const secondary=[
 {slug:'bladder-test-platform',asset:'A18',title:'A distensible bladder test platform',tags:'Design / Controls / Physical testing',copy:'From silicone phantom to pressure measurement: my sensing, control, and data acquisition work within a four-person capstone.',metrics:[['24.3%','team pressure-volume curve error']]},
 {slug:'cervical-fracture',asset:'A14',title:'Cervical fracture mechanics',tags:'Explicit dynamics / Injury biomechanics',copy:'Comparing Hybrid III injury criteria with GHBMC fracture predictions in head-first football impacts.',metrics:[['5','impact configurations']]},
 {slug:'seat-foam',asset:'A25',title:'Seat foam and rear impact',tags:'FEA / Material response',copy:'Trace the response from foam material checks to rear impact injury measures.',metrics:[['27 and 57 km/h','simulation speeds']]},
 {slug:'payload-and-rover',asset:'A31',title:'Payload systems and rover prototypes',tags:'CAD / Prototyping',copy:'Wheel, rover, and winch designs developed for a lightweight aerial payload system.',metrics:[]},
 {slug:'kidney-tissue-classification',asset:'A29',title:'Kidney tissue classification',tags:'Biomedical research / Deep learning',copy:'My work on image preparation, model training, and evaluation in an AlexNet classification workflow.',metrics:[]}
];
const toolkit=section('technical-toolkit');
const rows=[...toolkit.matchAll(/<tr>([\s\S]*?)<\/tr>/g)].slice(1).map(r=>[...r[1].matchAll(/<td>([\s\S]*?)<\/td>/g)].map(c=>c[1].trim()));
const history=(id:string)=>[...section(id).matchAll(/<tr>([\s\S]*?)<\/tr>/g)].slice(1).map(r=>[...r[1].matchAll(/<td>([\s\S]*?)<\/td>/g)].map(c=>c[1].trim()));
const intro=(hub.blocks[0] as any).text.split('\n')[1];
---
<section class="home-hero" aria-labelledby="intro-title">
  <div class="home-hero-grid">
    <div class="hero-copy"><p class="print-identity">Patrick Thangarajah</p>
      <p class="eyebrow hero-enter">Calgary, Alberta, Canada</p>
      <h1 id="intro-title" class="hero-enter">Mechanical Engineering Graduate</h1>
      <div class="hero-enter"><ul class="focus-areas"><li>Occupant Safety</li><li>Explicit Dynamics</li><li>FEA / Model Validation</li><li>Engineering Design</li></ul><p class="hero-support">{intro}</p></div>
      <div class="hero-actions hero-enter"><a class="button-link" href="#selected-work">My work <span aria-hidden="true">↓</span></a><a class="button-link secondary-button" href="#resume">Resume</a></div>
      <p class="eligibility hero-enter">Canadian citizen eligible to work in the United States under TN status</p>
    </div>
    <aside class="hero-feature" aria-labelledby="flagship-title">
      <div class="hero-feature-media">
        <a href="/projects/thor-5f/">
          <img src={(assets as any).A01.path} alt={(assets as any).A01.alt} width={(assets as any).A01.width} height={(assets as any).A01.height} decoding="async" />
        </a>
      </div>
      <div class="hero-feature-copy">
        <p class="eyebrow">Graduate Research</p>
        <h2 id="flagship-title"><a href="/projects/thor-5f/">THOR-5F Rear Seat Occupant Safety Research</a></h2>
        <p>How does seat belt anchor position change occupant response? Explore the validated THOR-5F bench models and anchor studies.</p>
        <div class="hero-feature-metrics">
          <div><strong>104</strong><span>FE simulations</span></div>
          <div><strong>2</strong><span>Physical test benchmark configurations</span></div>
        </div>
        <a class="case-link" href="/projects/thor-5f/">Full case study <span aria-hidden="true">→</span></a>
      </div>
    </aside>
  </div>
</section>
<section id="selected-work" class="home-section" aria-labelledby="work-title">
  <div class="section-heading"><p class="eyebrow">01 / Work</p><h2 id="work-title">Selected work</h2><span class="fringe-rule" aria-hidden="true"></span></div>
  <p class="work-meta">CAE / FEA · Design / Test · Biomechanics</p>
  <div class="gallery-grid">{secondary.map((c,i)=>{const a=(assets as any)[c.asset];const n=String(i+1).padStart(2,'0');return <a class:list={["gallery-item",{"placeholder-media":isPlaceholder(a.path)}]} href={`/projects/${c.slug}/`} style={`--stagger:${i%3*60}ms`}>
    <figure class="gallery-figure"><span class="gallery-frame"><img src={a.path} alt={isPlaceholder(a.path)?'Placeholder for: '+a.alt:a.alt} width={a.width} height={a.height} loading="lazy" decoding="async" />{isPlaceholder(a.path)&&<span class="media-label">Figure pending</span>}</span><figcaption class="fig-caption"><span class="fig-tag">FIG. {n}</span></figcaption></figure>
    <div class="gallery-copy"><p class="eyebrow">{c.tags}</p><h3>{c.title}</h3><p>{c.copy}</p>{c.metrics.length>0&&<p class="gallery-metric"><strong>{c.metrics[0][0]}</strong> {c.metrics[0][1]}</p>}</div>
  </a>;})}</div>
  <p class="index-more"><a href="/projects/design-and-applied-research/">Design & applied research index</a></p>
</section>
<section id="technical-toolkit" class="home-section" aria-labelledby="toolkit-title"><div class="section-heading"><h2 id="toolkit-title">Technical toolkit</h2><span class="fringe-rule" aria-hidden="true"></span></div><div class="toolkit-tags">{rows.map(([label,tools])=><div><h3>{label}</h3><p>{tools}</p></div>)}</div></section>
<section id="experience" class="home-section background-section" aria-labelledby="background-title"><div class="section-heading"><p class="eyebrow">02 / Experience</p><h2 id="background-title">Experience & education</h2><span class="fringe-rule" aria-hidden="true"></span></div>
  <div id="education"><h3>Education</h3><div class="timeline">{history('education').map(([period,degree,org])=><div><p class="timeline-date">{period}</p><div><h3>{org}</h3><p>{degree}</p></div></div>)}</div></div>
  <h3>Engineering experience</h3><div class="timeline">{history('experience').map(([period,role,org])=><div><p class="timeline-date">{period}</p><div><h3>{role.split('<br>')[0].replaceAll('**','')}</h3><p class="organization">{org}</p><div set:html={render(role.split('<br>').slice(1).join('<br>'),'Experience')}/></div></div>)}</div>
  <details id="about-me" class="disclosure"><summary>About my work</summary><p>Simulation, measurement, and engineering design.</p><div class="reading-column" set:html={render(section('about-me'),hub.title)}/><div id="at-a-glance" class="reading-column" set:html={render(section('at-a-glance'),hub.title)}/></details>
  <details id="publications-presentations" class="disclosure"><summary>Publications & presentations</summary><div class="reading-column" set:html={render(section('publications-presentations'),hub.title)}/></details>
  <details id="public-code-and-workflow-artifacts" class="disclosure"><summary>Public code & workflow artifacts</summary><div class="reading-column" set:html={render(section('public-code-and-workflow-artifacts'),hub.title)}/></details>
</section>
<section id="beyond-engineering" class="home-section beyond-engineering" aria-labelledby="beyond-title">
  <img src="/figures/IMG_1191.jpeg" alt="Portrait of Patrick Thangarajah" width="1834" height="1888" loading="lazy" decoding="async" />
  <div><h2 id="beyond-title">Beyond engineering</h2><p>Outside of work, I enjoy playing basketball, archery, lifting, and reading.</p></div>
</section>
<section id="contact" class="home-section" aria-labelledby="contact-title"><div class="section-heading"><p class="eyebrow">03 / Contact</p><h2 id="contact-title">Get in touch</h2><span class="fringe-rule" aria-hidden="true"></span></div><div class="contact-links"><a href="mailto:ptemmanual@gmail.com">ptemmanual@gmail.com</a><a href="https://www.linkedin.com/in/patrickthangarajah/">LinkedIn</a><a href="https://github.com/PatrickThangarajah">GitHub</a></div>
<div id="resume"><h3>Resume</h3><div class="download-grid resume-download-grid"><Download id="resume"/></div><details class="disclosure"><summary>Document details & work eligibility</summary><div class="reading-column" set:html={render(section('resume'),hub.title)}/></details></div></section>

<style>
  .beyond-engineering{display:grid;grid-template-columns:13rem minmax(0,38rem);gap:2rem;align-items:center}
  .beyond-engineering img{display:block;width:100%;max-width:13rem;height:auto}
  .beyond-engineering h2{margin:0 0 1rem}
  .beyond-engineering p{margin:0}
  @media(max-width:639px){.beyond-engineering{grid-template-columns:minmax(0,1fr);gap:1.5rem}.beyond-engineering img{max-width:11rem}}
</style>
