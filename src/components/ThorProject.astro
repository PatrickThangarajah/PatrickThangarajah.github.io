---
import assets from '../data/assets.json';
import Figure from './Figure.astro';

const {page} = Astro.props;
const asset = (id:string) => (assets as any)[id];
---

<article class="thor-case-study">
  <header class="thor-hero">
    <div class="thor-hero-copy">
      <p class="eyebrow">Graduate research</p>
      <h1>{page.title}</h1>
      <p class="thor-lede">Validated THOR-5F simulation → quantified restraint-geometry effects</p>
      <dl class="thor-metrics" aria-label="Study scope">
        <div><dd>104</dd><dt>LS-DYNA simulations</dt></div>
        <div><dd>4</dd><dt>full-factorial studies</dt></div>
        <div><dd>2</dd><dt>bench configurations</dt></div>
        <div><dd>0.71</dd><dt>average ISO 18571 in each bench</dt></div>
      </dl>
    </div>
    <div class="thor-hero-media"><Figure asset={asset('A01')} number={1} /></div>
  </header>

  <section class="thor-section" id="key-results">
    <div class="thor-section-heading">
      <h2>Key results</h2>
    </div>

    <div class="thor-result-grid">
      <article class="thor-result-card">
        <span class="eyebrow">Shoulder-anchor chest response</span>
        <strong>17% / 16%</strong>
        <p>The lowest observed rearward/inboard shoulder-anchor configurations produced peak chest deflection 17% and 16% below the Rigid and Semi-Rigid Bench study averages, respectively.</p>
      </article>
      <article class="thor-result-card">
        <span class="eyebrow">Validation</span>
        <strong>0.71</strong>
        <p>average ISO 18571 rating in each benchmark configuration.</p>
      </article>
      <article class="thor-result-card">
        <span class="eyebrow">Pelvis response</span>
        <strong>Lap anchors</strong>
        <p>had the stronger effect on pelvis acceleration.</p>
      </article>
      <article class="thor-result-card">
        <span class="eyebrow">Workflow</span>
        <strong>7 → 4</strong>
        <p>manual belt-fitting setup steps.</p>
      </article>
    </div>

    <div class="thor-result-visuals thor-result-visuals-single">
      <Figure asset={asset('A05')} number={5} />
    </div>

    <div class="thor-link-row">
      <a class="text-link" href="/projects/fe-validation/">FE model validation →</a>
      <a class="text-link" href="/projects/ls-prepost-automation/">LS-PrePost automation →</a>
    </div>
  </section>

  <section class="thor-section" id="research-workflow">
    <div class="thor-section-heading">
      <h2>Research workflow</h2>
      <p>Physical test → FE validation → anchor-position DOE</p>
    </div>

    <div class="thor-video-grid thor-video-grid-two">
      <figure class="thor-video-card">
        <video class="viewport-video" muted loop playsinline preload="none" data-src="/videos/thorrigidbenchgeneralsim.mp4" aria-label="Rigid Bench THOR-5F simulation"></video>
        <figcaption><strong>Rigid Bench</strong> · THOR-5F simulation</figcaption>
      </figure>
      <figure class="thor-video-card">
        <video class="viewport-video" muted loop playsinline preload="none" data-src="/videos/THORsemiRIGIDBENCHgeneralsim.mp4" aria-label="Semi-Rigid Bench THOR-5F simulation"></video>
        <figcaption><strong>Semi-Rigid Bench</strong> · THOR-5F simulation</figcaption>
      </figure>
    </div>

    <figure class="thor-video-card thor-anchor-video">
      <video class="viewport-video" muted loop playsinline preload="none" data-src="/videos/THOR_ANCHOR_DOE.mp4" aria-label="THOR-5F anchor location DOE animation"></video>
      <figcaption><strong>Anchor-position DOE</strong> · 104 physically feasible simulations</figcaption>
    </figure>
  </section>

  <section class="thor-section" id="anchor-response">
    <div class="thor-section-heading">
      <h2>Anchor response</h2>
    </div>

    <div class="comparison-group">
      <h3>Shoulder anchor · fore/aft</h3>
      <ul class="anchor-legend" aria-label="fore/aft video colors">
        <li><span class="anchor-swatch" style="--swatch:#000000" aria-hidden="true"></span>Forward</li>
        <li><span class="anchor-swatch" style="--swatch:#9f9f9f" aria-hidden="true"></span>Midpoint</li>
        <li><span class="anchor-swatch" style="--swatch:#92a1af" aria-hidden="true"></span>Rearward</li>
      </ul>
      <div class="comparison-video-grid">
        <figure>
          <video class="viewport-video" muted loop playsinline preload="none" data-src="/videos/THOR_RIGID_BENCH_SHOULDER_FOREAFTCOMPARISON.mp4" aria-label="Rigid Bench shoulder anchor fore-aft comparison"></video>
          <figcaption>Rigid Bench</figcaption>
        </figure>
        <figure>
          <video class="viewport-video" muted loop playsinline preload="none" data-src="/videos/THOR_SEMIRIGID_BENCH_SHOULDER_FOREAFTCOMPARISON.mp4" aria-label="Semi-Rigid Bench shoulder anchor fore-aft comparison"></video>
          <figcaption>Semi-Rigid Bench</figcaption>
        </figure>
      </div>
    </div>

    <div class="comparison-group">
      <h3>Shoulder anchor · inboard/outboard</h3>
      <ul class="anchor-legend" aria-label="inboard/outboard video colors">
        <li><span class="anchor-swatch" style="--swatch:#adaa07" aria-hidden="true"></span>Inboard</li>
        <li><span class="anchor-swatch" style="--swatch:#9f9f9f" aria-hidden="true"></span>Midpoint</li>
        <li><span class="anchor-swatch" style="--swatch:#ba9cab" aria-hidden="true"></span>Outboard</li>
      </ul>
      <div class="comparison-video-grid">
        <figure>
          <video class="viewport-video" muted loop playsinline preload="none" data-src="/videos/THOR_RIGID_BENCH_SHOULDER_INBOARDOUTBOARDCOMPARISON.mp4" aria-label="Rigid Bench shoulder anchor inboard-outboard comparison"></video>
          <figcaption>Rigid Bench</figcaption>
        </figure>
        <figure>
          <video class="viewport-video" muted loop playsinline preload="none" data-src="/videos/THOR_SEMIRIGID_BENCH_SHOULDER_INBOARDOUTBOARDCOMPARISON.mp4" aria-label="Semi-Rigid Bench shoulder anchor inboard-outboard comparison"></video>
          <figcaption>Semi-Rigid Bench</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="thor-section" id="engineering-interpretation">
    <div class="thor-section-heading">
      <h2>Engineering interpretation</h2>
    </div>
    <div class="interpretation-grid thor-interpretation-compact">
      <article><span>01</span><h3>Rearward shoulder anchor</h3><p>Earlier torso engagement and more gradual load transfer.</p></article>
      <article><span>02</span><h3>Inboard shoulder anchor</h3><p>Improved shoulder contact, with a belt-to-neck tradeoff at the extreme.</p></article>
      <article><span>03</span><h3>Lap anchor</h3><p>More configuration-dependent pelvis response.</p></article>
    </div>

    <aside class="boundary-callout thor-boundary thor-boundary-compact">
      <h3>Study boundary</h3>
      <p>Comparative sensitivity study within the evaluated design space, not a production restraint recommendation.</p>
    </aside>
  </section>
</article>

<script is:inline>
  (() => {
    const videos = Array.from(document.querySelectorAll('.thor-case-study .viewport-video'));
    const prepare = (video) => {
      if (!video.querySelector('source')) {
        const source = document.createElement('source');
        source.src = video.dataset.src;
        source.type = 'video/mp4';
        video.appendChild(source);
        video.load();
      }
      video.muted = true;
      video.defaultMuted = true;
      video.loop = true;
      video.playsInline = true;
      video.setAttribute('muted','');
      video.setAttribute('playsinline','');
    };
    const play = (video) => {
      prepare(video);
      const attempt = video.play();
      if (attempt && typeof attempt.catch === 'function') attempt.catch(() => {});
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        const video = entry.target;
        if (entry.isIntersecting) play(video);
        else video.pause();
      }), {rootMargin:'300px 0px', threshold:0.01});
      videos.forEach((video) => observer.observe(video));
    } else {
      videos.forEach(play);
    }
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) videos.forEach((video) => {
        const rect = video.getBoundingClientRect();
        if (rect.bottom >= -300 && rect.top <= innerHeight + 300) play(video);
      });
    });
  })();
</script>

<style>
  .anchor-legend { display:flex; flex-wrap:wrap; gap:.5rem 1.25rem; list-style:none; padding:0; margin:0 0 1rem; font:400 1rem/1.4 var(--ui); color:var(--ink); }
  .anchor-legend li { display:flex; align-items:center; gap:.45rem; margin:0; }
  .anchor-swatch { width:.75rem; height:.75rem; flex:none; background:var(--swatch); border:1px solid var(--secondary); }
</style>
