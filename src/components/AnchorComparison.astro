---
import { existsSync } from 'node:fs';
const webm='/videos/seat-belt-doe/thor5f-anchor-position-comparison.webm';
const mp4='/videos/seat-belt-doe/thor5f-anchor-position-comparison.mp4';
const poster='/figures/seat-belt-doe/thor5f-anchor-position-comparison-poster.png';
const publicPath=(path:string)=>process.cwd()+'/public'+path;
const hasWebm=existsSync(publicPath(webm));
const hasMp4=existsSync(publicPath(mp4));
const hasPoster=existsSync(publicPath(poster));
const hasVideo=hasWebm||hasMp4;
---
<figure class="local-video anchor-comparison">
  {hasVideo ? (
    <video width="596" height="317" poster={hasPoster ? poster : undefined} muted loop playsinline preload="metadata" controls aria-label="Minimum, midpoint, and maximum anchor locations">
      {hasWebm && <source src={webm} type="video/webm" />}
      {hasMp4 && <source src={mp4} type="video/mp4" />}
    </video>
  ) : hasPoster ? (
    <img src={poster} width="596" height="317" alt="Minimum, midpoint, and maximum anchor locations" loading="lazy" />
  ) : (
    <div class="placeholder-media" style="aspect-ratio:596/317" role="img" aria-label="Minimum, midpoint, and maximum anchor locations"></div>
  )}
  <figcaption>Minimum, midpoint, and maximum anchor locations.</figcaption>
  {!hasVideo && <p class="asset-status">Video file pending.</p>}
</figure>
